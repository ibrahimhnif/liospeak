{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LioSpeak",
  "version": "0.1.0",
  "identifier": "com.liospeak.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LioSpeak - AI Voice Dictation",
        "width": 780,
        "height": 680,
        "resizable": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "LioSpeak HUD",
        "url": "index.html#overlay",
        "width": 380,
        "height": 88,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
